# MongoDB Atlas Configuration (optional - app works without it using JSON file)
# Get your connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name

MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/customrisk?retryWrites=true&w=majority
MONGODB_DB_NAME=customrisk

# Optional: Override user DB path for local testing
# USER_DB_PATH=./public/users_data.json

# Server port (Render sets this automatically)
# PORT=3000
